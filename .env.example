# ====================================================================
# AURORA ACADEMIC CARE - ENVIRONMENT CONFIGURATION
# ====================================================================

# Application Info
NEXT_PUBLIC_APP_NAME="Aurora Academic Care"
NEXT_PUBLIC_APP_TAGLINE="Learn Today. Lead Tomorrow."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Supabase Cloud Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# SSLCOMMERZ Bangladesh Payment Gateway
# In test mode, set IS_LIVE to false. For production, set to true.
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcommerz_store_password"
SSLCOMMERZ_IS_LIVE="false"

# Notification Services (Optional Configurable Services)
SMS_GATEWAY_API_KEY=""
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
